{
  "name": "gyftr-occasion-admin-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Admin panel for building GyFTR occasion pages",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "sync:contracts": "node scripts/sync-contracts.mjs",
