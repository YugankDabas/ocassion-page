    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.0",
    "@tiptap/pm": "^2.27.0",
    "@tiptap/react": "^2.27.0",
    "@tiptap/starter-kit": "^2.27.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0",
