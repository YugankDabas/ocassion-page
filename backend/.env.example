# Local development: copy to .env and fill in.
# Deployed (ECS): put the keys of the "Deployed" block in ONE AWS Secrets Manager secret and set only
#   AWS_SECRET_NAME=<secret name>   AWS_REGION=ap-south-1
# on the task definition. Key names are not case-sensitive. See README.md → Configuration and Deploying.

# ---- Deployed: the keys that go in the secret ----
# PostgreSQL (RDS). The connection is built from these at start-up, with TLS and at most 10 connections per container.
DB_HOST=
DB_PORT=5432
DB_NAME=occasion_admin
DB_USER=
DB_PASSWORD=
# Signs admin sessions. Generate: openssl rand -base64 48
JWT_SECRET=
# Public URL the pages are published for. Page URLs entered in the panel must start with it.
PAGE_PUBLIC_BASE_URL=https://www.gyftr.com/occasion
# Bucket for uploaded images (name only). Region = AWS_REGION. Images are served from
# https://<bucket>.s3.<region>.amazonaws.com, so the bucket must allow public reads of its objects.
# Only the folder occasion-pages/ of the bucket is used, so the bucket can be shared with other applications.
S3_BUCKET=
# Optional. When the bucket may not be read publicly: the address images are served from, either this API
# (https://<api-host>/media; its task role then also needs s3:GetObject on <bucket>/occasion-pages/*) or a
# CloudFront address in front of the bucket.
# MEDIA_BASE_URL=

# Optional. Password of the read-only database login for the gyftr.com tech team (tech_reader).
# When set, the backend creates that login at start-up. Generate: openssl rand -base64 24
# TECH_READER_PASSWORD=

# ---- Local development only ----
# NODE_ENV=development
# The Prisma CLI (npm run db:deploy) reads this from .env; it replaces the DB_* fields locally.
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/occasion_admin
# Without S3_BUCKET, uploads are written to disk and served by the API:
# PUBLIC_UPLOADS_BASE_URL=http://localhost:4000/uploads

# ---- Optional (defaults shown; leave out unless they must change) ----
# RUN_MIGRATIONS_ON_START=true   # the schema is created / updated at every start-up
# PORT=4000
# LOG_LEVEL=info
# TRUST_PROXY=1            # load balancers in front of the API
# SESSION_TTL_HOURS=8
# MAX_UPLOAD_MB=8
# S3_PREFIX=occasion-pages # folder inside the bucket
# LOCAL_UPLOAD_DIR=./uploads
