{
  "family": "Occasion-Admin-Backend-TD",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["MANAGED_INSTANCES"],
  "cpu": "512",
  "memory": "1024",
  "taskRoleArn": "arn:aws:iam::653380732738:role/ecsTaskExecutionRole",
  "executionRoleArn": "arn:aws:iam::653380732738:role/ecsTaskExecutionRole",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "ARM64"
  },
  "containerDefinitions": [
    {
      "name": "Occasion-Admin-Backend-Container",
      "image": "653380732738.dkr.ecr.ap-south-1.amazonaws.com/occasion-admin-backend:b8c416a8aca5-14",
      "essential": true,
      "portMappings": [
        { "containerPort": 4545, "hostPort": 4545, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "4545" },
        { "name": "AWS_REGION", "value": "ap-south-1" },
        { "name": "AWS_SECRET_NAME", "value": "REPLACE_WITH_BACKEND_SECRET_NAME" },
        { "name": "RUN_MIGRATIONS_ON_START", "value": "true" },
        { "name": "ADMIN_FRONTEND_ORIGIN", "value": "https://occasion-admin.gyftr.net" },
        { "name": "TRUST_PROXY", "value": "1" }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:4545/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/Occasion-Admin-Backend-TD",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
